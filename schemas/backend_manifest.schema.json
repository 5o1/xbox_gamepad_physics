{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/5o1/xbox_gamepad_physics/schemas/backend_manifest.schema.json",
  "title": "Xbox One S simulator backend resource manifest",
  "type": "object",
  "required": [
    "schema_version",
    "asset_id",
    "backend",
    "profile",
    "entrypoint",
    "required_files",
    "reason"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "asset_id": {
      "const": "xbox_one_s"
    },
    "backend": {
      "enum": [
        "robotwin",
        "mujoco",
        "isaac"
      ]
    },
    "profile": {
      "type": "string",
      "minLength": 1
    },
    "entrypoint": {
      "type": [
        "string",
        "null"
      ]
    },
    "required_files": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "reason": {
      "type": [
        "string",
        "null"
      ]
    },
    "usage": {
      "description": "Public integration guidance attached to generated internal artifacts.",
      "type": "object",
      "properties": {
        "warning": {
          "type": "string"
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "example": {
          "type": "string"
        },
        "guide": {
          "const": "xbox-gamepad-physics guide"
        },
        "example_export": {
          "type": "string"
        }
      }
    },
    "motion_contract": {
      "type": "string",
      "pattern": "^common/xbox_one_s/motion/[A-Za-z0-9._-]+\\.json$"
    },
    "joint_dynamics": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "stiffness",
          "damping",
          "force_limit",
          "friction",
          "target"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "stiffness": {
            "type": "number",
            "minimum": 0
          },
          "damping": {
            "type": "number",
            "minimum": 0
          },
          "force_limit": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "friction": {
            "type": "number",
            "minimum": 0
          },
          "target": {
            "type": "number"
          }
        },
        "additionalProperties": false
      }
    },
    "scenes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "bindings": {
      "type": "object",
      "required": [
        "joints",
        "sensors"
      ],
      "properties": {
        "joints": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "sensors": {
          "type": "object",
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": true
}
