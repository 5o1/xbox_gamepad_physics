# Copy to configs/local/teleop_site.env; shell-quoted KEY=value, no shell commands.
# Values are private site settings. Environment variables override this file.
TELEOP_GPU_HOST='<gpu-host>'             # SSH destination address
TELEOP_SSH_PORT='<ssh-port>'             # SSH TCP port
TELEOP_SSH_USER='<ssh-user>'             # SSH account
TELEOP_SSH_IDENTITY='<ssh-identity-file>' # Private authentication file, local path
TELEOP_LOGIN_PROFILE='<login-profile>'   # Existing site SSH wrapper, supports --wohint
TELEOP_REMOTE_ROOT='<gpu-data-root>'     # Parent of per-session run directories
TELEOP_REMOTE_REPO='<gpu-repository>'    # Read-only run mirror of this repository
TELEOP_RESOURCE_ROOT='<resource-root>'   # Built Xbox resource cache
TELEOP_ROBOTWIN_ROOT='<robotwin-root>'   # Read-only RoboTwin assets
TELEOP_BASE_PYTHON='<sapien-3.0.3-python>' # Default physics and renderer executable
TELEOP_LEGACY_PYTHON='<sapien-3.0.0b1-python>' # Optional explicit legacy CoACD environment
TELEOP_STREAM_PYTHON='<stream-python>'   # Owned streaming environment executable
TELEOP_LOCAL_PYTHON='<local-python>'     # Local test/browser environment executable
TELEOP_CONDA_INIT='<conda-init-script>'  # For ordinary base-shell launcher validation
TELEOP_BROWSER='<system-browser>'       # System Chrome executable for measurement
TELEOP_GPU='<idle-gpu-index>'            # Default GPU; may override when launching
TELEOP_PORT='<windows-relay-port>'       # Windows localhost browser port
TELEOP_WSL_PORT='<wsl-tunnel-port>'      # WSL tunnel listening port
TELEOP_WSL_INTERFACE='<wsl-interface>'   # Interface whose address is detected at launch
TELEOP_REMOTE_PORT='<service-port>'      # GPU loopback service port
# Communication test setting: integer seconds, default 60, allowed 10–300.
# Shared by SSH keepalive failure detection and the remote idle watchdog.
TELEOP_TUNNEL_TIMEOUT_S=60
TELEOP_LOCAL_OUTPUT='<local-output>'     # Absolute or repository-relative artifact directory
