# Merge these entries into your private TELEOP_SITE_CONFIG file.
# Paths belong to the installation site; never commit the filled file.
TELEOP_ISAAC_PYTHON='<existing-isaac-python>'
TELEOP_ISAAC_LIBRARY_ROOT='<existing-isaac-environment-lib-directory>'
TELEOP_RESOURCE_ROOT='<prepared-common-resource-directory>'
TELEOP_LOCAL_OUTPUT='<preview-output-directory>'
# Select only an explicitly authorized physical GPU, after checking occupancy.
TELEOP_GPU='<authorized-physical-gpu-index>'
