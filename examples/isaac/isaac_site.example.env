# Merge these entries into your private TELEOP_SITE_CONFIG file.
# Same parser and override rules as configs/teleop_site.example.env.
# Paths belong to the installation site; never commit the filled file.
TELEOP_ISAAC_PYTHON='<existing-isaac-python>'
TELEOP_ISAAC_LIBRARY_ROOT='<existing-isaac-environment-lib-directory>'
TELEOP_RESOURCE_ROOT='<extracted-preview-resources>'
TELEOP_LOCAL_OUTPUT='<preview-output-directory>'
TELEOP_GPU='<idle-gpu-index>'
# Optional appearance review inputs:
# TELEOP_CAMERA_PLAN='<approved-camera-plan-json>'
# TELEOP_HDR='<approved-lighting-hdr>'
# Optional historical SAPIEN field diagnostics only:
# TELEOP_PHYSX_GPU_LIBRARY='<explicitly-provisioned-libPhysXGpu_64.so>'
# TELEOP_EIGEN_INCLUDE='<eigen-include-directory>'
